classDiagram
    class User {
        -int id
        -string email
        -string password
        -string role
    }

    class Author {
        -int id
        -string last_name
        -string first_name
        -string biographie
        -string avatar
    }

    class Article {
        -int id
        -int id_categorie
        -string title
        -text content
        -string status
        -DateTime creation_date
    }

    User "1" --> "0..1" Author : is
    Author "1" --> "*" Article : writes